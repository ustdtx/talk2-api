# Copy to .env and fill in. NEVER commit .env (real secrets).
# Render injects PORT automatically. Keep 8080 for local/container runs.
PORT=8080

# Managed Postgres (Aiven)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/talk2?sslmode=require

# Managed Redis (Upstash). Keep the rediss:// scheme (TLS).
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# JWT signing secret (generate 32 random bytes hex, keep private)
JWT_SECRET=change-me-to-64-hex-chars

# Presence: seconds a heartbeat keeps you online + reaper sweep interval.
# Grace: seconds after the last socket closes before offline teardown
# (reloads/blips reconnect first and cancel it; 0 = reaper only).
PRESENCE_TTL_SEC=60
PRESENCE_SWEEP_SEC=10
PRESENCE_GRACE_SEC=10

# Rate limits: true in prod. Set false for development (no throttles at all).
RATE_LIMITS_ENABLED=false

# Feed cap: max live posts. Oldest-first cascade delete past the cap.
# Lower it when the box is hot (this is the load lever).
FEED_MAX_POSTS=300

# Feed batch windows follow crowd size: short when quiet (fresh posts),
# long when packed (efficient). Changes at most once per few minutes.
FEED_BATCH_MIN_SEC=15
FEED_BATCH_MAX_SEC=300

# Cloudflare R2 (S3-compatible) — bucket honeybadgerb1
S3_BUCKET=honeybadgerb1
S3_REGION=auto
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://<public-host>.r2.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Comma-separated deployed UI origins, for example:
# CORS_ORIGINS=https://talk2-ui.vercel.app
CORS_ORIGINS=http://localhost:3000
